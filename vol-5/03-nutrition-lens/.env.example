# Copy to .env and fill in, or just export it in your shell.
# This variable is optional. With it unset, the project runs fully local and
# you type the foods yourself, which is the default way to use it.
#
# lens.py reads this one variable and nothing else.

# Optional. Turns on the --ai photo path only.
# When you pass --ai AND this is set, the image bytes for that one photo are
# sent to the Anthropic API so Claude can name the foods. Your nutrition
# database, your profile, and every rule stay on your machine. Without --ai,
# no photo is opened by a network call at all.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
