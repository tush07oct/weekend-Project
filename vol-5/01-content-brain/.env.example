# Copy to .env and fill in, or just export it in your shell.
# This variable is optional. With it unset, the project runs fully local, which
# is the default and the way the README walks you through it.
#
# build_board.py reads this one variable and nothing else. ask.py reads none.

# Optional. Only consulted when you also pass --ai. Two uses, both narrow:
#   1. placing the items local scoring flagged as too close to call
#      (sends your project names plus the text of those items only)
#   2. reading an image when the tesseract CLI is not installed
#      (sends that image file's bytes, base64, and nothing else)
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
